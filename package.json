{
  "name": "qa-practice-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E tests for qa-practice-api and qa-practice-web",
  "scripts": {
    "e2e": "node bin/reset-db.mjs && playwright test",
    "e2e:fast": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "db:reset": "node bin/reset-db.mjs",
    "types": "node bin/download-schema.mjs && kubb generate",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@kubb/adapter-oas": "^5.23.1",
    "@kubb/cli": "^5.23.1",
    "@kubb/core": "^5.23.1",
    "@kubb/plugin-client": "^6.4.0",
    "@kubb/plugin-faker": "^5.5.0",
    "@kubb/plugin-fetch": "^6.4.0",
    "@kubb/plugin-oas": "^4.39.3",
    "@kubb/plugin-ts": "^5.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "kubb": "^5.23.1"
  },
  "private": true
}
